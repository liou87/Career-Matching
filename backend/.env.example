# 必填：LLM API Key（DeepSeek）
DEEPSEEK_API_KEY=sk-xxxxxx

# 以下均为可选，完整列表见 app/core/config.py
# MODEL_ANALYSIS=deepseek-chat      # 按角色换模型：jd_parse / analysis / suggest / merge / agent
# LLM_TIMEOUT=60                    # 单次调用超时（秒）
# ACCESS_TOKEN=                     # 设了就要求访问口令
# LOG_JSON=false                    # 线上建议 true，每条日志一行 JSON

# LangSmith 链路追踪（可选）
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_xxx
# LANGSMITH_PROJECT=careermatch
